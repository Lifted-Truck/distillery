#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
set -uo pipefail

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

record() { # record <target> <exit_code>
  local git_hash; git_hash=$(git rev-parse --short HEAD 2>/dev/null || echo "no-git")
  printf '{"target":"%s","exit":%d,"git":"%s","ts":"%s"}\n' \
    "$1" "$2" "$git_hash" "$(date -u +%FT%TZ)" > "$HARNESS_DIR/last-verify.json"
  rm -f "$HARNESS_DIR/dirty"
  return "$2"
}

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  # D0 scaffold gate: structure + manifest + invariant sanity.
  # D1 extends: ruff check . && pytest -q tests/unit
  local ok=0
  for f in README.md CLAUDE.md ROADMAP.md project.manifest.json; do
    [ -f "$f" ] || { echo "verify[fast]: missing $f" >&2; ok=1; }
  done
  python3 -c "import json;json.load(open('project.manifest.json'))" 2>/dev/null \
    || { echo "verify[fast]: project.manifest.json is not valid JSON" >&2; ok=1; }
  grep -q "APPEND-ONLY" CLAUDE.md \
    || { echo "verify[fast]: charter lost the append-only invariant" >&2; ok=1; }
  return $ok
}

full() {
  fast || return $?
  # ---- Layer-E: the whole gate. Run before closing a queue item. -----------
  # D0: identical to fast. D1 adds fixture-stream golden replays +
  # idempotency double-run check (see ROADMAP D1 gate).
  return 0
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
