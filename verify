#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
#
# THIS FILE IS PROJECT-OWNED. Kit-owned gates (record, leak_gate,
# kit_integrity) live in .kit/kit-gates.sh — vendored and checksummed; never
# edit or inline them. Update with: python3 <kit>/kit_sync.py .
set -uo pipefail

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity. A repo missing this file
# is not a lesser repo, it is an UNGATED one, so failing loudly beats degrading
# quietly — a silently skipped privacy gate is exactly the shape of bug the
# gate exists to prevent.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  # D0 scaffold gate: structure + manifest + invariant sanity.
  # D1 extension (ROADMAP decision 4): stdlib lint floor + unit tests via
  # python3 -m unittest (pytest/ruff deferred until the human provisions them).
  local ok=0
  kit_integrity || ok=1      # kit-owned files must match .kit/MANIFEST
  leak_gate     || ok=1      # privacy gate: kit-core, keep it first
  for f in README.md CLAUDE.md ROADMAP.md project.manifest.json; do
    [ -f "$f" ] || { echo "verify[fast]: missing $f" >&2; ok=1; }
  done
  python3 -c "import json;json.load(open('project.manifest.json'))" 2>/dev/null \
    || { echo "verify[fast]: project.manifest.json is not valid JSON" >&2; ok=1; }
  grep -q "APPEND-ONLY" CLAUDE.md \
    || { echo "verify[fast]: charter lost the append-only invariant" >&2; ok=1; }
  python3 -m compileall -q distillery bin/ingest tests \
    || { echo "verify[fast]: compileall failed" >&2; ok=1; }
  python3 -m unittest discover -q -s tests/unit -t . \
    || { echo "verify[fast]: unit tests failed" >&2; ok=1; }
  return $ok
}

full() {
  fast || return $?
  # ---- Layer-E: the whole gate. Run before closing a queue item. -----------
  # D1 (ROADMAP D1 gate): fixture-stream golden replay + byte-identical
  # fresh-run replay + idempotency double-run, all via the real CLI.
  python3 tests/replay_check.py \
    || { echo "verify[full]: replay_check failed" >&2; return 1; }
  return 0
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
